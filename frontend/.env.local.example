# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (HTTP driver). Get this from the Neon
# project dashboard. Example: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Base URL of the FastAPI screener service (backend/src/screener/api/app.py) that serves /quotes and /losers.
SCREENER_API_URL=http://localhost:8000

# Auth.js v5 secret used to sign/encrypt JWT session tokens. Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 33
AUTH_SECRET=

# Hardcoded dashboard login — plain-text username, compared with a strict
# string match in auth.ts.
DASHBOARD_USER=

# bcrypt hash of the dashboard password (never store the plain password).
# Generate it locally with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
#
# IMPORTANT: Next.js's built-in env loader (@next/env) performs dotenv-expand
# style ${VAR} interpolation on every .env* file. A raw bcrypt hash contains
# multiple unescaped `$` segments (e.g. $2b$10$...), which get silently
# parsed as variable references and stripped out, corrupting the hash and
# making every login fail with no useful error. Escape every `$` as `\$`
# below, e.g.:
#   DASHBOARD_PASSWORD_HASH=\$2b\$10\$Lpbq4GMW4K8rlah1Br6I/.eDwMMWbLIH.PXA2niVKCaWaJwhLmITK
DASHBOARD_PASSWORD_HASH=
