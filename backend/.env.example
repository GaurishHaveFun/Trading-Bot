FINNHUB_API_KEY=
ALPACA_KEY=
ALPACA_SECRET=
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=.cache/schwab_token.json
DATA_PROVIDER=schwab
ALERT_THRESHOLD=0.70
# Optional: Neon Postgres connection string. Enables the (future) web
# dashboard to read run/signal/backtest history. Leave blank to skip DB
# writes entirely — the screener runs fine without it.
DATABASE_URL=
# Render API key, for scripts/schwab_reauth.py to push a refreshed Schwab
# token and trigger a redeploy. Generate one from your Render account's
# API Keys page (dashboard -> account settings -> API Keys).
RENDER_API_KEY=
# Render service ID for the deployed trading-bot-api service, e.g.
# srv-xxxxx. Found in the service's dashboard URL/settings page.
RENDER_SERVICE_ID=
# Anthropic API key that powers the ticker AI analysis endpoint. Leave
# blank to disable the feature -- it returns 503 when this is blank.
ANTHROPIC_API_KEY=
# Google Gemini API key that powers the ticker AI analysis endpoint when
# ANALYSIS_PROVIDER=gemini (the default -- free tier via gemini-3.5-flash).
# Leave blank to disable the Gemini path.
GEMINI_API_KEY=
# Which analysis provider to use: "gemini" (default, free-tier friendly) or
# "anthropic".
ANALYSIS_PROVIDER=gemini
# Gemini model ID. Pinned to a dated model rather than the rolling
# "gemini-flash-latest" alias, which can roll onto a newer model with no
# free-tier quota (this happened) and silently break the analysis feature.
GEMINI_MODEL=gemini-3.5-flash
# Whether to enable web search grounding for the analysis providers.
# Default is false: Google Search grounding is NOT free-tier eligible on
# Gemini -- attaching it returns 429 RESOURCE_EXHAUSTED on every model
# tried, even though plain (non-grounded) calls succeed. Leave this off for
# the out-of-the-box Gemini free-tier config. Set to true if you're on a
# paid Gemini plan, or when using ANALYSIS_PROVIDER=anthropic, whose web
# search tool has no such free-tier restriction.
ANALYSIS_WEB_SEARCH=false
